# Medichain API configuration. `make env` copies this to backend/.env with fresh secrets.

ENVIRONMENT=development
LOG_LEVEL=INFO

# Frontend origin(s), comma-separated. PUBLIC_APP_URL is used in sign-in messages and report QR codes.
CORS_ORIGINS=http://localhost:5173
PUBLIC_APP_URL=http://localhost:5173
ENABLE_DOCS=true

# Wallet sign-in. JWT_SECRET must be at least 32 characters.
JWT_SECRET=
JWT_TTL_MINUTES=60
# Optional comma-separated allowlist of wallet addresses. Empty means any wallet may sign in.
ALLOWED_WALLETS=

# Base64-encoded 32-byte AES key. Files on IPFS are encrypted with it.
# Back it up: losing it makes every stored file unreadable.
ENCRYPTION_KEY=

# IPFS provider: "kubo" (local node from `make ipfs`) or "pinata".
IPFS_PROVIDER=kubo
KUBO_API_URL=http://127.0.0.1:5001
PINATA_JWT=
PINATA_GATEWAY_URL=https://gateway.pinata.cloud

# Chain. The defaults match `make chain` + `make deploy` (Hardhat local node).
CHAIN_ID=31337
CHAIN_RPC_URL=http://127.0.0.1:8545
CONTRACT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3

# Hugging Face model IDs (safetensors weights required), and inference device.
BRAIN_TUMOR_MODEL=Hemgg/brain-tumor-classification
CHEST_XRAY_MODEL=lxyuan/vit-xray-pneumonia-classification
DEVICE=auto
PRELOAD_MODELS=false

MAX_UPLOAD_MB=10
