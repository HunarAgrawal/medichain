# Medichain API configuration. `make env` copies this to backend/.env with fresh keys.

ENVIRONMENT=development
LOG_LEVEL=INFO
# Lists the demo accounts on the login page. Must be false in production.
DEMO_MODE=true

# Where the web app is served. Used for CORS, cookies and links in reports.
PUBLIC_APP_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
ENABLE_DOCS=true

# Accounts and sessions. SQLite for development; any async SQLAlchemy URL in production.
DATABASE_URL=sqlite+aiosqlite:///./data/medichain.db
SESSION_TTL_HOURS=12
# Must be true in production (HTTPS only).
COOKIE_SECURE=false

# Base64-encoded 32-byte AES keys. Back them up: losing one makes data unreadable.
# ENCRYPTION_KEY protects scans and reports; WALLET_ENCRYPTION_KEY protects users' wallet keys.
ENCRYPTION_KEY=
WALLET_ENCRYPTION_KEY=

# IPFS provider: "kubo" (local node from `make ipfs`) or "pinata".
IPFS_PROVIDER=kubo
KUBO_API_URL=http://127.0.0.1:5001
PINATA_JWT=
PINATA_GATEWAY_URL=https://gateway.pinata.cloud

# Chain. The defaults match `make chain` + `make deploy` (local Hardhat node).
CHAIN_ID=31337
CHAIN_RPC_URL=http://127.0.0.1:8545
CONTRACT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3
# The operator owns the registry (verifies clinicians) and pays users' gas.
# This is Hardhat's public development key: it is only accepted on chain 31337.
OPERATOR_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
# Optional block explorer for transaction links, e.g. https://sepolia.etherscan.io
EXPLORER_URL=

# Hugging Face model IDs (safetensors weights required), and inference device.
BRAIN_TUMOR_MODEL=Hemgg/brain-tumor-classification
CHEST_XRAY_MODEL=lxyuan/vit-xray-pneumonia-classification
DEVICE=auto
PRELOAD_MODELS=false

MAX_UPLOAD_MB=10
