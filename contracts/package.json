{
  "name": "medichain-contracts",
  "private": true,
  "description": "Medichain on-chain record registry",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "compile": "hardhat build",
    "test": "hardhat test",
    "node": "hardhat node",
    "deploy:local": "hardhat ignition deploy ignition/modules/MediChainRecords.ts --network localhost",
    "deploy:sepolia": "hardhat ignition deploy ignition/modules/MediChainRecords.ts --network sepolia",
    "clean": "hardhat clean"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.6.1"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ethers": "^4.2.1",
    "@nomicfoundation/hardhat-ignition": "^3.1.9",
    "@nomicfoundation/hardhat-toolbox-mocha-ethers": "^4.0.0",
    "@types/chai": "^5.2.3",
    "@types/chai-as-promised": "^8.0.2",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.5",
    "chai": "^6.3.0",
    "ethers": "^6.17.0",
    "hardhat": "^3.20.0",
    "mocha": "^12.0.3",
    "typescript": "^6.0.3"
  }
}
